// Cloudflare Workers config for PKI-ZEN.
// Serves the VitePress build output as static assets.
// Used by `npx wrangler deploy` (the Deploy command in Workers Builds).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pki-zen",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./publish/site/.vitepress/dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "pki-zen.h2oatlas.ee", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
