# Cloudflare Pages headers for pki-zen.h2oatlas.ee
# Assets cached aggressively; HTML revalidated on each request.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Probability signature — for humans reading headers.
/*
  X-Probability: infinity
  X-Verses: 108x3
  X-Silence: between two CRL updates
