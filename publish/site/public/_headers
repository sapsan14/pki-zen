# Cloudflare headers for pki-zen.tyche.institute
#
# Immutability is reserved for VitePress fingerprinted assets (they
# contain a hash in the filename, so they're safe to cache forever).
# Top-level assets (logo.svg, favicon.svg, og.png) change under their
# fixed names, so they must be revalidated often or fresh content is
# invisible to returning readers for a year.

# VitePress fingerprinted assets — safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts (self-hosted or otherwise) — cache for a year, but not immutable.
/*.woff2
  Cache-Control: public, max-age=31536000

# Top-level images (logo/favicon/og) — revalidate on every request.
/logo.svg
  Cache-Control: public, max-age=300, must-revalidate
/logo.png
  Cache-Control: public, max-age=300, must-revalidate
/favicon.svg
  Cache-Control: public, max-age=300, must-revalidate
/og.png
  Cache-Control: public, max-age=3600, must-revalidate

# Everything else: short cache + security headers.
/*
  Cache-Control: public, max-age=300, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Probability signature — for humans reading headers.
/*
  X-Probability: infinity
  X-Verses: 108x3
  X-Silence: between two CRL updates
